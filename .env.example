# AgentE API keys — copy to .env and fill in the ones you need.
#   cp .env.example .env
# .env is git-ignored and is NOT baked into the image; it is injected at run
# time via `--env-file` / docker-compose `env_file`. Leave a key blank to skip
# the feature that needs it.

# Stage 9 — LeakIX leak intelligence (https://leakix.net)
LEAKIX_API_KEY=

# Stage 9 — Gitminer3 GitHub secret mining (a GitHub Personal Access Token)
GITHUB_TOKEN=

# Stage 8 — IntelX / phonebook.cz email enumeration (https://free.intelx.io)
INTELX_KEY=

# Stage 9 — Google dorking via the Tavily API (https://tavily.com)
TAVILY_API_KEY=
